# ==============================================================================
# STOCK ANALYTICS - ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env: copy .env.example .env (hoặc cp .env.example .env)
# ==============================================================================

# 1. VNSTOCK API KEY (Nguồn dữ liệu thị trường chính)
# Lấy API Key miễn phí tại: https://vnstocks.com/account#api-key
# Nếu chưa có, bạn có thể ĐỂ TRỐNG (hệ thống sẽ chạy ở chế độ Community mặc định)
VNSTOCK_API_KEY=
VNSTOCK_SOURCE=VCI

# 2. DNSE – GIÁ REALTIME (Không bắt buộc)
# Giá thường ngày lấy từ API biểu đồ công khai của DNSE (không cần tài khoản, ~3 phút/lần).
# Muốn giá REALTIME (khớp lệnh từng giây): nhập API key + secret của DNSE OpenAPI, lấy tại
# Entrade X → Thông tin cá nhân → Light Speed. App CHỈ ĐỌC GIÁ, không đặt lệnh, không cần OTP.
# KHÔNG chia sẻ 2 giá trị này cho bất kỳ ai. Để trống = dùng giá ~3 phút/lần như trước.
DNSE_API_KEY=
DNSE_API_SECRET=
# DNSE_WS_URL=wss://ws-openapi.dnse.com.vn        # Sandbox: wss://ws-sb-openapi.dnse.com.vn (dùng key Sandbox)
# DNSE_REALTIME=1                                 # đặt 0 để tạm tắt realtime dù đã có key
# REALTIME_REFRESH_SECONDS=3                      # nhịp làm mới ô giá trên trang khi có realtime

# 3. MÔI TRƯỜNG & LOGGING
APP_ENV=development
LOG_LEVEL=INFO

# 4. THỜI GIAN LƯU CACHE (Giây)
CACHE_TTL_PRICE=1800        # 30 phút cho chuỗi giá ngày (giá trong phiên cập nhật riêng mỗi 3 phút)
CACHE_TTL_FINANCIAL=3600    # 1 giờ cho Báo cáo tài chính
CACHE_TTL_MARKET=60         # 1 phút cho chỉ số thị trường

# 5. ĐƯỜNG DẪN CƠ SỞ DỮ LIỆU & BỘ NHỚ CỤC BỘ (Giữ nguyên mặc định)
DB_PATH=./data/stock_analytics.duckdb
CACHE_DIR=./data/cache
REPORTS_DIR=./reports/output

DOCUMENTS_DIR=./data/documents   # nơi lưu BCTN / BCTC dạng PDF đã tải

# 6. CHIẾN LƯỢC KẾT HỢP NGUỒN DỮ LIỆU (v2)
# Giá N ngày gần nhất lấy từ DNSE (API biểu đồ công khai, không cần tài khoản)
DNSE_RECENT_DAYS=365
# Giá lịch sử (cũ hơn N ngày): thử lần lượt từ trái sang phải
PRICE_HISTORY_SOURCES=vnstock_vci,vnstock_kbs,vnstock_msn,vietstock
# BCTC: nguồn trước được ưu tiên, nguồn sau bù kỳ / chỉ tiêu còn thiếu
FINANCIAL_SOURCES=vnstock_vci,vnstock_kbs,vietstock,arminer,pdf
# Nơi dò tài liệu PDF (sau đó luôn thử thêm website doanh nghiệp)
DOCUMENT_SOURCES=vietstock,cafef
CACHE_TTL_NEWS=1800
CACHE_TTL_DOCUMENTS=86400

# Đổi chuỗi này sau mỗi thay đổi công thức/schema để vô hiệu cache cũ.
CACHE_SCHEMA_VERSION=gpm1-v4

# Polling giá trong phiên. Nguồn hiện dùng nến phút nên không nên gọi mỗi giây.
LIVE_REFRESH_SECONDS=180   # giá DNSE trong phiên tự cập nhật mỗi 3 phút (tối thiểu 180)

# Giới hạn tải lên/tải xuống tài liệu (100 MiB)
MAX_DOCUMENT_BYTES=104857600

# Fallback point-in-time khi nguồn chưa cung cấp ngày công bố thật.
ANNUAL_RELEASE_MONTH=4
QUARTER_RELEASE_LAG_DAYS=50

# Nguồn logo doanh nghiệp (tùy chọn) – danh sách mẫu URL cách nhau bằng dấu phẩy, {symbol} = mã cổ phiếu
# LOGO_URL_TEMPLATES=https://cdn.simplize.vn/simplizevn/logo/{symbol}.jpeg
